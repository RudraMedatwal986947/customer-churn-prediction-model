# Exclude version control
.git
.gitignore

# Exclude Python caches
__pycache__/
*.py[cod]
*.pyc
.pytest_cache/

# Exclude virtual environments
.venv/
venv/
env/

# Exclude IDE files
.idea/
.vscode/
*.swp
*.swo

# Exclude large data files from build context (they are mounted at runtime via volumes)
# data/ is mounted via docker-compose volume so it doesn't need to be in the image
# Uncomment the line below ONLY if you switch away from volume mounts:
# data/

# Exclude test artifacts and docs
htmlcov/
.coverage
coverage.xml

# Exclude markdown docs (not needed at runtime)
*.md
!README.md
